@page "/"
@layout MainLayout
@inject AuthSession Session

<PageTitle>داشبورد</PageTitle>

@if (!Session.IsAuthenticated)
{
    <MudPaper Class="pa-8 text-center" Elevation="0">
        <MudIcon Icon="@Icons.Material.Filled.Translate" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h4" Class="mt-4">پنل مدیریت مترجمان</MudText>
        <MudText Typo="Typo.body1" Class="mt-2 mb-6">برای ادامه وارد حساب کاربری خود شوید.</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">ورود</MudButton>
    </MudPaper>
}
else
{
    <MudText Typo="Typo.h4" Class="mb-6">داشبورد</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-5 dashboard-card" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
                <MudText Typo="Typo.h6" Class="mt-3">کاربران</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">مشاهده و جست‌وجوی کاربران</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/users">مشاهده کاربران</MudButton>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-5 dashboard-card" Elevation="1">
                <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Secondary" />
                <MudText Typo="Typo.h6" Class="mt-3">نقش‌ها</MudText>
                <MudText Typo="Typo.body2" Class="mb-4">مدیریت نقش‌ها و دسترسی‌ها</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/roles">مشاهده نقش‌ها</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
